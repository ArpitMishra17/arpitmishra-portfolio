[Unit]
Description=Portfolio TUI over SSH (ssh tui.arpitmishra.dev)
After=network-online.target
Wants=network-online.target

[Service]
User=tui
Group=tui
# Host key is read from .ssh/host_ed25519 relative to this dir.
WorkingDirectory=/opt/tui
Environment=PORT=22
ExecStart=/opt/tui/tui
Restart=always
RestartSec=2

# Bind :22 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tui/.ssh

[Install]
WantedBy=multi-user.target
